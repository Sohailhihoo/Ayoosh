# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/beauty-store

# Redis Connection (for server-side sessions)
REDIS_URL=redis://localhost:6379

# Stripe Payment (get keys from https://dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayFast Payment (get credentials from https://www.payfast.co.za)
PAYFAST_MERCHANT_ID=your_merchant_id
PAYFAST_MERCHANT_KEY=your_merchant_key
PAYFAST_PASSPHRASE=your_passphrase
PAYFAST_SANDBOX=true

# PayGate Payment (get credentials from https://www.paygate.co.za)
PAYGATE_ID=your_paygate_id
PAYGATE_SECRET=your_paygate_secret

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Email Configuration (optional - for password reset emails)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@beautystore.com
FROM_NAME=Beauty Store
